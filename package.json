{
  "name": "market-analysis",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "build:web": "pnpm build && pnpm --filter @ma/web build",
    "dev:web": "pnpm --filter @ma/web dev",
    "job": "pnpm --filter @ma/web job",
    "db:generate": "pnpm --filter @ma/db generate",
    "db:migrate": "pnpm --filter @ma/db migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
