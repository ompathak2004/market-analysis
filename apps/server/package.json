{
  "name": "@ma/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --conditions=@ma/source src/main.ts",
    "dev:worker": "tsx watch --conditions=@ma/source src/worker/main.ts",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker/main.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@ma/cache": "workspace:*",
    "@ma/core": "workspace:*",
    "@ma/db": "workspace:*",
    "@ma/ingest": "workspace:*",
    "@ma/intel": "workspace:*",
    "fastify": "^5.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5"
  }
}
