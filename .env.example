NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgres://postgres:postgres@localhost:5432/market_analysis
REDIS_URL=redis://localhost:6379

API_KEY=change-me-to-a-long-random-string
ADMIN_API_KEY=

FIRECRAWL_API_KEY=fc-...
FIRECRAWL_MONTHLY_CREDITS=900

CEREBRAS_API_KEY=csk-...
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_FALLBACK_MODEL=qwen-3.8-27b
CEREBRAS_RPM=5
LLM_DAILY_TOKEN_BUDGET=800000
LLM_BUDGET_RELATIONSHIPS=
LLM_BUDGET_INSIGHTS=
LLM_BUDGET_INFLUENCE=

AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
ALTDATA_ENABLED=true
ALTDATA_AIS_BURST_SECONDS=45

INTEL_UNIVERSE=NIFTY100
DATA_UNIVERSE=NIFTY500
SPLC_PRESENTATIONS_PILOT=false
NSE_BASE_URL=https://www.nseindia.com
SCRAPE_CONCURRENCY=4

# Worker (apps/worker). Optional locally.
RESEND_API_KEY=
OPS_DIGEST_TO=
S3_ARCHIVE_BUCKET=
BACKUP_ENCRYPTION_KEY=
CLOUDWATCH_METRICS=false

NEXT_ALLOWED_DEV_ORIGINS=

# Web analytics (apps/web, public browser configuration; set before building).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
